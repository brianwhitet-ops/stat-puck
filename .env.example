# Durable waitlist inbox. Required for production on Vercel.
# Create a form at https://formspree.io (free), then paste the form hash only.
# Example URL: https://formspree.io/f/xpwkgqzw  →  FORMSPREE_FORM_ID=xpwkgqzw
FORMSPREE_FORM_ID=

# Optional. Used by `node site/preview.mjs` so local signups persist on disk.
# Production on Vercel ignores this (serverless disk is ephemeral).
# WAITLIST_LOCAL_PATH=site/.data/waitlist.json
